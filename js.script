document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('form-pedido');
    const spanTotal = document.getElementById('valor-total');

    function calcularTotal() {
        let total = 0;

        const selecionados = form.querySelectorAll(
            'input[type="checkbox"]:checked, input[type="radio"]:checked'
        );

        selecionados.forEach(function(el) {
            const preco = parseFloat(el.getAttribute('data-preco')) || 0;
            total += preco;
        });

        spanTotal.textContent = `R$ ${total.toFixed(2).replace('.', ',')}`;
    }

    form.addEventListener('change', calcularTotal);

    form.addEventListener('submit', function(e) {
        e.preventDefault();

        const nome = document.getElementById('Nm').value;
        const endereco = document.getElementById('End').value;
        const pagamento = document.getElementById('pagamento').value;

        const pizzas = form.querySelectorAll(
            'input[name="PizzaSalgada"]:checked, input[name="PizzaDoce"]:checked'
        );

        if (pizzas.length === 0) {
            alert('Por favor, selecione pelo menos uma pizza para o seu pedido!');
            return;
        }

        alert(`Obrigado pelo pedido, ${nome}!

Seu pedido foi registrado com sucesso e será entregue em:
${endereco}.

Forma de pagamento: ${pagamento}
Total: ${spanTotal.textContent}

Bom apetite! 🍕`);

        form.reset();
        calcularTotal();
    });
});
